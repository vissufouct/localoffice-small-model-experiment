{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LocalOffice Experiment",
  "version": "0.1.0",
  "identifier": "local.localoffice.experiment",
  "build": {
    "beforeDevCommand": "npm run web",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LocalOffice Experiment \u2014 small-model harness",
        "width": 1440,
        "height": 960,
        "minWidth": 1000,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; worker-src 'self' blob:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "category": "Productivity",
    "shortDescription": "Local artifact workspace"
  }
}
